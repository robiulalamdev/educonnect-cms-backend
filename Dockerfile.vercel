FROM node:22-alpine

WORKDIR /app

# Install ALL deps (dev included) so tsx + prisma CLI are available.
# Do this BEFORE setting NODE_ENV=production, otherwise npm skips devDependencies.
COPY .npmrc ./
COPY package*.json ./
COPY prisma.config.js ./
RUN npm ci

ENV NODE_ENV=production
ENV PORT=80

COPY tsconfig.json ./
COPY src ./src

# Generate Prisma client (the generated dir is gitignored)
RUN npm run prisma:generate

EXPOSE 80

# Run via tsx — avoids depending on a tsc build step
CMD ["npx", "tsx", "src/server.ts"]
