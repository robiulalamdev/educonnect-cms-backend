FROM node:22-alpine

WORKDIR /app

# Install ALL deps (dev included) so tsx + prisma CLI are available.
# Do this BEFORE setting NODE_ENV=production, otherwise npm skips devDependencies.
COPY .npmrc ./
COPY package*.json ./
COPY prisma.config.js ./
RUN npm ci

ENV NODE_ENV=production
ENV PORT=80

# Build-time placeholder so `prisma generate` can resolve its datasource URL.
# prisma generate does NOT connect to the DB; the real DATABASE_URL from
# Vercel project env vars overrides this at runtime.
ENV DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder?schema=public"

COPY tsconfig.json ./
COPY src ./src

# Generate Prisma client (the generated dir is gitignored)
RUN npm run prisma:generate

EXPOSE 80

# Run via tsx — avoids depending on a tsc build step
CMD ["npx", "tsx", "src/server.ts"]
