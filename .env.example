COOKIE_REFRESH_NAME=
COOKIE_ACCESS_MAX_AGE=
COOKIE_REFRESH_MAX_AGE=

# JWT - Admin Auth
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_ACCESS_EXPIRES=
ADMIN_JWT_REFRESH_EXPIRES=

# Cookies - Admin
