# Application
NODE_ENV=development
PORT=9000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/coaching_management?schema=public

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://educonnect-cms.vercel.app

# JWT - User Auth
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=30d

# Cookies - User
COOKIE_SECRET=your-cookie-secret-min-32-chars
COOKIE_ACCESS_NAME=cms_access_token
COOKIE_REFRESH_NAME=cms_refresh_token
COOKIE_ACCESS_MAX_AGE=86400000
COOKIE_REFRESH_MAX_AGE=2592000000

# JWT - Admin Auth
ADMIN_JWT_ACCESS_SECRET=your-admin-access-secret-min-32-chars
ADMIN_JWT_REFRESH_SECRET=your-admin-refresh-secret-min-32-chars
ADMIN_JWT_ACCESS_EXPIRES=1d
ADMIN_JWT_REFRESH_EXPIRES=30d

# Cookies - Admin
ADMIN_COOKIE_ACCESS_NAME=cms_admin_access
ADMIN_COOKIE_REFRESH_NAME=cms_admin_refresh
ADMIN_COOKIE_ACCESS_MAX_AGE=86400000
ADMIN_COOKIE_REFRESH_MAX_AGE=2592000000

ADMIN_PANEL_ORIGINS=http://localhost:3000,https://educonnect-cms.vercel.app

# Cloudinary (Image/Video Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ACCOUNT_ID=your-account-id

# Email (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASS=your-app-password

# Firebase (FCM Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_VAPID_PUBLIC_KEY=your-vapid-public-key
FIREBASE_SENDER_ID=your-numeric-sender-id

# Frontend URLs (for Socket.io CORS)
FRONTEND_URL=https://educonnect-cms.vercel.app
ADMIN_FRONTEND_URL=https://educonnect-cms.vercel.app