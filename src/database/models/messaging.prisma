// ============================================================
// MODULE: messaging.prisma
// DIRECT: 1-on-1, created once on first contact, never duplicated
// BATCH_GROUP: auto-created when a batch is created
// ============================================================

model Chat {
    id   String   @id @default(cuid())
    type ChatType

    // only set for BATCH_GROUP
    batch_id String? @unique
    batch    Batch?  @relation("batch_chat", fields: [batch_id], references: [id])

    // service context — for DIRECT chats, links to a teacher's service
    // so both parties know what they're discussing
    service_id String?
    service    Service? @relation(fields: [service_id], references: [id])

    name      String? // group name for batch chats
    avatar_id String? @unique // replaces avatar_url
    avatar    Media?  @relation(fields: [avatar_id], references: [id])

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    participants ChatParticipant[]
    messages     Message[]
    read_trackings ChatReadTracking[]

    @@index([service_id])
    @@map("chats")
}

model ChatParticipant {
    id        String    @id @default(cuid())
    chat_id   String
    chat      Chat      @relation(fields: [chat_id], references: [id], onDelete: Cascade)
    user_id   String
    user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
    joined_at DateTime  @default(now())
    is_muted  Boolean   @default(false)

    @@unique([chat_id, user_id])
    @@map("chat_participants")
}

// ============================================================
// READ TRACKING — separate schema, per user per chat/group.
// Mirrors the MongoDB ReadTracking pattern: ONE row per user per
// chat instead of per-message flags. This scales for group chats
// with many participants.
//   last_read_at: timestamp of the last message the user read
//   unread_count: incrementally maintained on send, reset on read
//     (avoids expensive per-chat COUNT queries for the inbox)
// Indexed on (chat_id, user_id) unique and (user_id, last_read_at)
// for fast lookup of unread conversations.
// ============================================================

model ChatReadTracking {
    id           String   @id @default(cuid())
    chat_id      String
    chat         Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
    user_id      String
    user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
    last_read_at DateTime @default(now())
    unread_count Int      @default(0)

    @@unique([chat_id, user_id])
    @@index([user_id, last_read_at])
    @@index([chat_id, last_read_at])
    @@map("chat_read_trackings")
}

model Message {
    id        String  @id @default(cuid())
    chat_id   String
    chat      Chat    @relation(fields: [chat_id], references: [id], onDelete: Cascade)
    sender_id String
    sender    User    @relation(fields: [sender_id], references: [id], onDelete: Cascade)
    body      String? @db.Text
    media     Media[] @relation("MessageMedia")

    // service context tag — user attaches a service to the conversation
    // so both parties know what they are discussing
    context_service_id String?

    is_deleted Boolean       @default(false)

    // reply threading
    reply_to_id String?
    reply_to    Message?  @relation("replies", fields: [reply_to_id], references: [id])
    replies     Message[] @relation("replies")

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([chat_id])
    @@index([sender_id])
    @@index([created_at])
    @@map("messages")
}
